---
import { t } from '../i18n';
---

<header class="static-hud">
  <a class="brand" href="/">
    <span class="mark" aria-hidden="true"></span>
    <span class="word">{t('app.name')}</span>
  </a>
  <nav aria-label={t('nav.main')}>
    <a href="/">{t('nav.tree')}</a>
    <a href="/about">{t('nav.about')}</a>
  </nav>
</header>

<style>
  .static-hud {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--hud-h);
    padding: 0 var(--gutter);
    background: color-mix(in oklab, var(--bg) 92%, transparent);
    border-bottom: 1px solid var(--rule);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
    min-height: 44px;
  }
  .mark {
    width: 14px;
    height: 14px;
    transform: rotate(45deg);
    border: 1.5px solid var(--gold);
    box-shadow: 0 0 10px color-mix(in oklab, var(--gold) 60%, transparent);
  }
  .word,
  nav {
    font-family: var(--font-display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .word {
    font-size: 1.35rem;
  }
  nav {
    display: flex;
    gap: 1rem;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
</style>
