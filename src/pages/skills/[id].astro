---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import StaticHeader from '../../components/StaticHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import NodeDetail from '../../components/NodeDetail.svelte';
import { getTreeData } from '../../lib/content';
import { t } from '../../i18n';

export const getStaticPaths = (async () => {
  const data = await getTreeData();
  return data.nodes.map((node) => ({ params: { id: node.id } }));
}) satisfies GetStaticPaths;

const data = await getTreeData();
const node = data.nodes.find((n) => n.id === Astro.params.id)!;
const branch = data.branches.find((b) => b.id === node.branch)!;
const related = (ids: string[]) =>
  ids
    .map((id) => data.nodes.find((n) => n.id === id))
    .filter((n) => !!n)
    .map((n) => ({ id: n.id, title: n.title, color: data.branches.find((b) => b.id === n.branch)?.color ?? '#999' }));
const settings = {
  readyLeadWeeks: data.settings.readyLeadWeeks,
  horizonWeeks: data.settings.horizonWeeks,
  disclaimer: data.settings.disclaimer,
  pastWindowNote: data.settings.pastWindowNote,
};
const plain = node.html.replace(/<[^>]+>/g, '').trim().split('\n')[0]?.slice(0, 160);
---

<Base title={`${node.title} · Dovahkiin`} description={plain}>
  <StaticHeader />
  <main class="page skill-page">
    <div class="top">
      <nav class="crumbs" aria-label={t('nav.breadcrumb')}>
        <a href="/">{t('nav.tree')}</a> <span aria-hidden="true">›</span> <a href={`/?family=${branch.id}`}>{branch.name}</a>
      </nav>
      <a class="btn btn-sm open" href={`/?skill=${node.id}`}>{t('detail.openInTree')}</a>
    </div>
    <div class="panel card">
      <NodeDetail
        {node}
        {branch}
        prereqs={related(node.prereqs)}
        unlocks={related(node.unlocks)}
        {settings}
        showDisclaimer={false}
      />
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }
  .crumbs {
    font-family: var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    display: flex;
    gap: 0.5rem;
  }
  .crumbs a {
    color: var(--ink-2);
  }
  .card {
    padding: 1.75rem 2rem;
    background: var(--panel-solid);
  }
  @media (max-width: 640px) {
    .card {
      padding: 1.25rem 1rem;
    }
  }
</style>
